{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Check forward diffusion (CPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/check_forward.py",
      "args": ["--part", "forward", "--device", "cpu"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug five training updates (CPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": ["--device", "cpu", "--steps", "5", "--batch-size", "16", "--output", "outputs/debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
